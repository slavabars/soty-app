<?xml version="1.0" encoding="utf-8"?>
<!--
    Soty keeps its identity seeds encrypted with a key that lives in the
    Android Keystore and never leaves the device. A system backup would copy
    the ciphertext without that key, and the restored app could never start
    again (AEADBadTagException). It would also upload decrypted media to the
    cloud. The app has its own password-protected backup file, so cloud backup
    and device transfer are disabled for every domain.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
