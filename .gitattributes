# Normalise line endings so builds are the same on every host.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ogg binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.otf binary
*.jar binary
*.so binary

# Generated code: keep it in diffs but out of language stats.
lib/core/storage/database.g.dart linguist-generated=true
*.g.dart linguist-generated=true
*.freezed.dart linguist-generated=true

# Vendored plugin: do not count it as project code.
third_party/** linguist-vendored=true
